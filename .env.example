# --- Frontend (Vite). Written to .env.local automatically by `npx convex dev`. ---
VITE_CONVEX_URL=
# Clerk publishable key (pk_test_... / pk_live_...). Public, but set it in .env.local and in Netlify/Vercel.
VITE_CLERK_PUBLISHABLE_KEY=

# --- Convex-side env vars. Do NOT put these in a file: set them on each deployment ---
#   npx convex env set YOUCAM_API_KEY <key>        (YouCam Skin Analysis API, server-side only)
#   npx convex env set OPENROUTER_API_KEY <key>    (explanation text; without it the templated text is used)
#   npx convex env set OPENROUTER_MODEL <ids>      (optional, comma-separated, tried in order; default: a few free chat models)
#   npx convex env set RESEND_API_KEY <re_...>     (scan reminder emails; without it none are sent)
#   npx convex env set EMAIL_FROM "Receipts <onboarding@resend.dev>"
#   npx convex env set APP_URL <https://your-site>  (links in the emails)
#   npx convex env set EMAIL_ALLOWED_TO <address>   (who really gets email: comma list, * = everyone, empty = nobody)
#   npx convex env set CLERK_JWT_ISSUER_DOMAIN <url>  (Clerk "Frontend API URL", e.g. https://your-name-00.clerk.accounts.dev)
#   npx convex env set CLERK_SECRET_KEY <sk_...>   (Clerk secret key: demo user, demo tickets, account deletion)
# Every deployment (each dev's own dev deployment) needs its own copy of these.
