# --- Frontend (Vite). Written to .env.local automatically by `npx convex dev`. ---
VITE_CONVEX_URL=

# --- Convex-side env vars. Do NOT put these in a file: set them on each deployment ---
#   npx convex env set YOUCAM_API_KEY <key>        (YouCam Skin Analysis API, server-side only)
#   npx convex env set OPENROUTER_API_KEY <key>    (explanation text)
#   Convex Auth also needs JWT_PRIVATE_KEY, JWKS and SITE_URL (set up by `npx @convex-dev/auth`).
# Every deployment (each dev's dev deployment and prod) needs its own copy of these.
